{
  "expo": {
    "name": "FajrGuard",
    "slug": "fajrguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fajrguard",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/audio/adhan.wav",
            "./assets/audio/adhan_fajr.wav"
          ]
        }
      ],
      "expo-task-manager",
      "expo-background-fetch",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "FajrGuard uses the camera to verify your face and detect wudu (ablution) moisture on-device."
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableCoreMLDelegate": true,
          "enableAndroidGpuLibraries": true
        }
      ],
      "expo-audio"
    ],
    "android": {
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "USE_FULL_SCREEN_INTENT"
      ],
      "package": "com.anonymous.fajrguard"
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.fajrguard",
      "entitlements": {
        "com.apple.developer.usernotifications.critical-alerts": true
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used for wudu verification - detecting moisture on your face after ablution.",
        "NSMicrophoneUsageDescription": "Not used.",
        "UIBackgroundModes": ["audio", "fetch", "processing"]
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bbc1fcf1-2995-4777-92e6-e0ddb8369c07"
      }
    },
    "owner": "th3samaritan"
  }
}
